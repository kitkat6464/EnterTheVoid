#!/usr/bin/env bash

#----------------------------------------#
# Start - Catrina's Post Setup - Midgard #
#----------------------------------------#

echo
echo "Refresh Repos"
echo

sudo pacman -Syu --noconfirm

echo
echo "Done!"
echo

echo
echo "Enable Graphical Target"
echo

sudo systemctl set-default graphical.target

echo
echo "Done!"
echo

echo
echo "Install SDDM"
echo

sudo pacman -S --noconfirm sddm

echo
echo "Done!"
echo

echo
echo "Enable SDDM"
echo

sudo systemctl enable sddm

echo
echo "Done!"
echo

echo
echo "Install Niri"
echo

PKGS=(
	'niri'
	'gnome-keyring'
	'xwayland-satellite'
	'xdg-desktop-portal-gtk'
	'xdg-desktop-portal-gnome'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm
done

echo
echo "Done!"
echo

echo
echo "Install Noctalia"
echo

PKGS=(
	'ddcutil'
	'cliphist'
	'noctalia'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm
done

echo
echo "Done!"
echo

echo
echo "Install Theming"
echo

PKGS=(
	'adw-gtk-theme'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm
done

echo
echo "Done!"
echo

echo
echo "Refresh Repos Again"
echo

sudo pacman -Syu --noconfirm

echo
echo "Done!"
echo

#--------------------------------------#
# End - Catrina's Post Setup - Midgard #
#--------------------------------------#
