#!/usr/bin/env bash

#----------------------------------------#
# Start - Catrina's Post Setup - Midgard #
#----------------------------------------#

echo
echo "Refresh Repos"
echo

sudo pacman -Syu --noconfirm

echo
echo "Done!"
echo

echo
echo "Enable Graphical Target"
echo

sudo systemctl set-default graphical.target

echo
echo "Done!"
echo

echo
echo "Install GreetD Regreet"
echo

sudo pacman -S --noconfirm greetd-regreet

echo
echo "Done!"
echo

echo
echo "Configure GreetD Regreet Niri"
echo

sudo bash -c 'cat <<EOF > /etc/greetd/niri.kdl

spawn-sh-at-startup "regreet; niri msg action quit --skip-confirmation"
hotkey-overlay {
    skip-at-startup
}
EOF'

echo
echo "Done!"
echo

echo
echo "Configure GreetD Regreet"
echo

sudo bash -c 'cat <<EOF > /etc/greetd/config.conf

[default_session]
command = "dbus-run-session niri --config /etc/greetd/niri.kdl"
user = "greeter"
EOF'

echo
echo "Done!"
echo

echo
echo "Enable GreetD Regreet"
echo

sudo systemctl enable greetd

echo
echo "Done!"
echo

echo
echo "Install Niri and Deps"
echo

PKGS=(
	'niri'
	'gnome-keyring'
	'xwayland-satellite'
	'xdg-desktop-portal-gtk'
	'xdg-desktop-portal-gnome'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm
done

echo
echo "Done!"
echo

echo
echo "Install Noctalia"
echo

PKGS=(
	'ddcutil'
	'cliphist'
	'noctalia'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm
done

echo
echo "Done!"
echo

echo
echo "Install Theming"
echo

PKGS=(
	'adw-gtk-theme'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm
done

echo
echo "Done!"
echo

echo
echo "Refresh Repos Again"
echo

sudo pacman -Syu --noconfirm

echo
echo "Done!"
echo

#--------------------------------------#
# End - Catrina's Post Setup - Midgard #
#--------------------------------------#
