{
        "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
                "logo": {
                    "type": "kitty",
                    "source": "/home/catrina/.config/fastfetch/cute-takopii-anime-sticker.png", // https://wallpapers-clan.com/sticker-png/hello-kitty-among-us-pink/
                    "height": 15,
                    "width": 25,
                    "padding": {
                        "top": 8,
                        "left": 4,
                        "right": 4
                    }
        },
        "display": {
            "separator": " ► ",
            "bar": {
            "char": {
            "elapsed": "",
            "total": ""
        },
            "width": 4
        },
    
            "percent": {
                "type": 2
            }
        },
        "modules": [
            "break",
            "break",
            {
                "type": "title",
                "format": " 👑 {1}@{2} 👑",
            },
            {
                "type": "custom",
                "format": "───────────────────────────────────────────────────",
            },
            {
                "type": "custom",
                "format": "System:",
            },
            {
                "type": "os",
                "key": " 🧩 OS  ",
            },
            {
                "type": "kernel",
                "key": " ⚙️ KRNL",
            },
            {
                "type": "packages",
                "key": " 📦 PKGS",
            },
            {
                "type": "shell",
                "key": " 🐚 SH  ",
            },
            {
                "type": "uptime",
                "key": " ⏱️ UP  ",
            },
            {
                "type": "command",
                "key": " ⏳ AGE ",
                "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
            },
            {
                "type": "custom",
                "format": "───────────────────────────────────────────────────",
            },
            {
                "type": "custom",
                "format": "Desktop:",
            },
            {
                "type": "de",
                "key": " 🪟 DE  ",
            },
            {
                "type": "wm",
                "key": " 🧭 WM  ",
            },
            {
                "type": "lm",
                "key": " 🔐 LM  ",
            },
            {
                "type": "wmtheme",
                "key": " 🎨 THM ",
            },
            {
                "type": "icons",
                "key": " 🧩 ICO ",
            },
            {
                "type": "terminal",
                "key": " 🖥️ TERM",
            },
            {
                "type": "custom",
                "format": "───────────────────────────────────────────────────",
            },
            {
                "type": "custom",
                "format": "Hardware:",
            },
            {
                "type": "host",
                "key": " 💻 HST ",
            },
            {
                "type": "cpu",
                "key": " 🧠 CPU ",
                "format": "{1}"
            },
            {
                "type": "gpu",
                "key": " 🎮 GPU ",
            },
            {
                "type": "disk",
                "key": " 💾 DSK ",
            },
            {
                "type": "memory",
                "key": " 🧬 RAM ",
            },
            {
                "type": "swap",
                "key": " 🔄 SWP ",
            },
            {
                "type": "custom",
                "format": "───────────────────────────────────────────────────",
            },
            ]
}
